# Tracked: dataset + code, configs, policy resources, docs, notebooks, tests.
/*
!/.gitignore
!/README.md
!/pyproject.toml

!/data/
/data/*
!/data/processed/

!/src/
!/configs/
!/resources/
!/docs/
!/annotations/
!/notebooks/
!/scripts/
!/tests/

# Local-only
__pycache__/
*.pyc
.pytest_cache/
.venv/
outputs/
build/

Autobots.pdf
RULES.md
